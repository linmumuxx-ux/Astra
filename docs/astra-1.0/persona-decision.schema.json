{
  "$defs": {
    "AskHumanAction": {
      "additionalProperties": false,
      "properties": {
        "admission_id": {
          "title": "Admission Id",
          "type": "string"
        },
        "type": {
          "const": "ask_human",
          "title": "Type",
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/OperationInput"
        }
      },
      "required": [
        "admission_id",
        "type",
        "operation"
      ],
      "title": "AskHumanAction",
      "type": "object"
    },
    "CriterionResult": {
      "additionalProperties": false,
      "properties": {
        "criterion_index": {
          "minimum": 0,
          "title": "Criterion Index",
          "type": "integer"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/NativeCitation"
          },
          "maxItems": 10,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "criterion_index",
        "passed",
        "reason"
      ],
      "title": "CriterionResult",
      "type": "object"
    },
    "DispatchAction": {
      "additionalProperties": false,
      "properties": {
        "admission_id": {
          "title": "Admission Id",
          "type": "string"
        },
        "type": {
          "const": "dispatch",
          "title": "Type",
          "type": "string"
        },
        "task": {
          "$ref": "#/$defs/TaskInput"
        },
        "worker_id": {
          "title": "Worker Id",
          "type": "string"
        }
      },
      "required": [
        "admission_id",
        "type",
        "task",
        "worker_id"
      ],
      "title": "DispatchAction",
      "type": "object"
    },
    "FollowUpAction": {
      "additionalProperties": false,
      "properties": {
        "admission_id": {
          "title": "Admission Id",
          "type": "string"
        },
        "type": {
          "const": "follow_up",
          "title": "Type",
          "type": "string"
        },
        "after_seconds": {
          "maximum": 604800,
          "minimum": 60,
          "title": "After Seconds",
          "type": "integer"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "admission_id",
        "type",
        "after_seconds",
        "reason"
      ],
      "title": "FollowUpAction",
      "type": "object"
    },
    "HandoffAction": {
      "additionalProperties": false,
      "properties": {
        "admission_id": {
          "title": "Admission Id",
          "type": "string"
        },
        "type": {
          "const": "handoff",
          "title": "Type",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "handoff": {
          "$ref": "#/$defs/HandoffInput"
        }
      },
      "required": [
        "admission_id",
        "type",
        "task_id",
        "handoff"
      ],
      "title": "HandoffAction",
      "type": "object"
    },
    "HandoffInput": {
      "additionalProperties": false,
      "properties": {
        "target_employee_id": {
          "title": "Target Employee Id",
          "type": "string"
        },
        "reason": {
          "default": "工作责任交接",
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "target_employee_id"
      ],
      "title": "HandoffInput",
      "type": "object"
    },
    "NativeCitation": {
      "additionalProperties": false,
      "properties": {
        "native_session_id": {
          "pattern": "^ses[a-zA-Z0-9_-]+$",
          "title": "Native Session Id",
          "type": "string"
        },
        "message_id": {
          "pattern": "^msg[a-zA-Z0-9_-]+$",
          "title": "Message Id",
          "type": "string"
        },
        "part_id": {
          "pattern": "^prt[a-zA-Z0-9_-]+$",
          "title": "Part Id",
          "type": "string"
        },
        "excerpt": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "native_session_id",
        "message_id",
        "part_id",
        "excerpt"
      ],
      "title": "NativeCitation",
      "type": "object"
    },
    "NoAction": {
      "additionalProperties": false,
      "properties": {
        "admission_id": {
          "title": "Admission Id",
          "type": "string"
        },
        "type": {
          "const": "no_action",
          "title": "Type",
          "type": "string"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "admission_id",
        "type",
        "reason"
      ],
      "title": "NoAction",
      "type": "object"
    },
    "OperationInput": {
      "additionalProperties": false,
      "properties": {
        "team_id": {
          "title": "Team Id",
          "type": "string"
        },
        "action": {
          "enum": [
            "task.pause",
            "task.cancel",
            "employee.pause",
            "knowledge.publish"
          ],
          "title": "Action",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "expires_in": {
          "default": 3600,
          "maximum": 86400,
          "minimum": 60,
          "title": "Expires In",
          "type": "integer"
        }
      },
      "required": [
        "team_id",
        "action",
        "target_id"
      ],
      "title": "OperationInput",
      "type": "object"
    },
    "RememberAction": {
      "additionalProperties": false,
      "properties": {
        "admission_id": {
          "title": "Admission Id",
          "type": "string"
        },
        "type": {
          "const": "remember",
          "title": "Type",
          "type": "string"
        },
        "content": {
          "maxLength": 16000,
          "title": "Content",
          "type": "string"
        },
        "notes": {
          "description": "文件名不含 notes/ 前缀",
          "maxProperties": 20,
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]{0,63}\\.md$": {
              "type": "string"
            }
          },
          "title": "Notes",
          "type": "object"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        }
      },
      "required": [
        "admission_id",
        "type",
        "content",
        "reason"
      ],
      "title": "RememberAction",
      "type": "object"
    },
    "ReplyAction": {
      "additionalProperties": false,
      "properties": {
        "admission_id": {
          "title": "Admission Id",
          "type": "string"
        },
        "type": {
          "const": "reply",
          "title": "Type",
          "type": "string"
        },
        "content": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "admission_id",
        "type",
        "content"
      ],
      "title": "ReplyAction",
      "type": "object"
    },
    "ReviewAction": {
      "additionalProperties": false,
      "properties": {
        "admission_id": {
          "title": "Admission Id",
          "type": "string"
        },
        "type": {
          "const": "review",
          "title": "Type",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "review": {
          "$ref": "#/$defs/TaskReviewInput"
        }
      },
      "required": [
        "admission_id",
        "type",
        "task_id",
        "review"
      ],
      "title": "ReviewAction",
      "type": "object"
    },
    "TaskInput": {
      "additionalProperties": false,
      "properties": {
        "team_id": {
          "title": "Team Id",
          "type": "string"
        },
        "owner_employee_id": {
          "title": "Owner Employee Id",
          "type": "string"
        },
        "title": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "acceptance_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "goal_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Goal Id"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "required_capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Required Capabilities",
          "type": "array"
        },
        "asset_scope": {
          "additionalProperties": true,
          "title": "Asset Scope",
          "type": "object"
        },
        "priority": {
          "default": 3,
          "maximum": 5,
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "risk_level": {
          "default": "LOW",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ],
          "title": "Risk Level",
          "type": "string"
        }
      },
      "required": [
        "team_id",
        "owner_employee_id",
        "title",
        "objective",
        "acceptance_criteria"
      ],
      "title": "TaskInput",
      "type": "object"
    },
    "TaskReviewInput": {
      "additionalProperties": false,
      "properties": {
        "execution_id": {
          "title": "Execution Id",
          "type": "string"
        },
        "expected_task_revision": {
          "minimum": 1,
          "title": "Expected Task Revision",
          "type": "integer"
        },
        "outcome": {
          "enum": [
            "COMPLETED",
            "REWORK",
            "WAIT_HUMAN"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "criteria_results": {
          "items": {
            "$ref": "#/$defs/CriterionResult"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Criteria Results",
          "type": "array"
        }
      },
      "required": [
        "execution_id",
        "expected_task_revision",
        "outcome",
        "criteria_results"
      ],
      "title": "TaskReviewInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan": {
      "maxLength": 4000,
      "title": "Plan",
      "type": "string"
    },
    "actions": {
      "items": {
        "discriminator": {
          "mapping": {
            "ask_human": "#/$defs/AskHumanAction",
            "dispatch": "#/$defs/DispatchAction",
            "follow_up": "#/$defs/FollowUpAction",
            "handoff": "#/$defs/HandoffAction",
            "no_action": "#/$defs/NoAction",
            "remember": "#/$defs/RememberAction",
            "reply": "#/$defs/ReplyAction",
            "review": "#/$defs/ReviewAction"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ReplyAction"
          },
          {
            "$ref": "#/$defs/NoAction"
          },
          {
            "$ref": "#/$defs/RememberAction"
          },
          {
            "$ref": "#/$defs/DispatchAction"
          },
          {
            "$ref": "#/$defs/FollowUpAction"
          },
          {
            "$ref": "#/$defs/AskHumanAction"
          },
          {
            "$ref": "#/$defs/HandoffAction"
          },
          {
            "$ref": "#/$defs/ReviewAction"
          }
        ]
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Actions",
      "type": "array"
    }
  },
  "required": [
    "plan",
    "actions"
  ],
  "title": "PersonaDecision",
  "type": "object"
}
