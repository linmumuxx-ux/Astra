  {
    "name": "astra_task_get",
    "description": "读取业务任务权威事实；执行消息仍在原生 Session。",
    "inputSchema": {
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id"
      ],
      "title": "task_getArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "task_getDictOutput",
      "type": "object"
    }
  },
  {
    "name": "astra_task_create",
    "description": "在当前员工岗位、责任与工程授权内创建业务 Task。",
    "inputSchema": {
      "$defs": {
        "TaskInput": {
          "additionalProperties": false,
          "properties": {
            "team_id": {
              "title": "Team Id",
              "type": "string"
            },
            "owner_employee_id": {
              "title": "Owner Employee Id",
              "type": "string"
            },
            "title": {
              "maxLength": 240,
              "minLength": 1,
              "title": "Title",
              "type": "string"
            },
            "objective": {
              "minLength": 1,
              "title": "Objective",
              "type": "string"
            },
            "acceptance_criteria": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "title": "Acceptance Criteria",
              "type": "array"
            },
            "goal_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Goal Id"
            },
            "constraints": {
              "items": {
                "type": "string"
              },
              "title": "Constraints",
              "type": "array"
            },
            "required_capabilities": {
              "items": {
                "type": "string"
              },
              "title": "Required Capabilities",
              "type": "array"
            },
            "asset_scope": {
              "additionalProperties": true,
              "title": "Asset Scope",
              "type": "object"
            },
            "priority": {
              "default": 3,
              "maximum": 5,
              "minimum": 1,
              "title": "Priority",
              "type": "integer"
            },
            "risk_level": {
              "default": "LOW",
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH"
              ],
              "title": "Risk Level",
              "type": "string"
            }
          },
          "required": [
            "team_id",
            "owner_employee_id",
            "title",
            "objective",
            "acceptance_criteria"
          ],
          "title": "TaskInput",
          "type": "object"
        }
      },
      "properties": {
        "payload": {
          "$ref": "#/$defs/TaskInput"
        },
        "operation_key": {
          "title": "Operation Key",
          "type": "string"
        }
      },
      "required": [
        "payload",
        "operation_key"
      ],
      "title": "task_createArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "task_createDictOutput",
      "type": "object"
    }
  },
  {
    "name": "astra_task_handoff",
    "description": "提出正式交接；被接收方签收前不改变主责。",
    "inputSchema": {
      "$defs": {
        "HandoffInput": {
          "additionalProperties": false,
          "properties": {
            "target_employee_id": {
              "title": "Target Employee Id",
              "type": "string"
            },
            "reason": {
              "default": "工作责任交接",
              "minLength": 1,
              "title": "Reason",
              "type": "string"
            }
          },
          "required": [
            "target_employee_id"
          ],
          "title": "HandoffInput",
          "type": "object"
        }
      },
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/HandoffInput"
        },
        "operation_key": {
          "title": "Operation Key",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "payload",
        "operation_key"
      ],
      "title": "task_handoffArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "task_handoffDictOutput",
      "type": "object"
    }
  },
  {
    "name": "astra_task_review",
    "description": "按原始标准独立验收；必须提供后端重新核验的原生工具引用，Worker 不能自审。",
    "inputSchema": {
      "$defs": {
        "CriterionResult": {
          "additionalProperties": false,
          "properties": {
            "criterion_index": {
              "minimum": 0,
              "title": "Criterion Index",
              "type": "integer"
            },
            "passed": {
              "title": "Passed",
              "type": "boolean"
            },
            "reason": {
              "maxLength": 2000,
              "minLength": 1,
              "title": "Reason",
              "type": "string"
            },
            "evidence": {
              "items": {
                "$ref": "#/$defs/NativeCitation"
              },
              "maxItems": 10,
              "title": "Evidence",
              "type": "array"
            }
          },
          "required": [
            "criterion_index",
            "passed",
            "reason"
          ],
          "title": "CriterionResult",
          "type": "object"
        },
        "NativeCitation": {
          "additionalProperties": false,
          "properties": {
            "native_session_id": {
              "pattern": "^ses[a-zA-Z0-9_-]+$",
              "title": "Native Session Id",
              "type": "string"
            },
            "message_id": {
              "pattern": "^msg[a-zA-Z0-9_-]+$",
              "title": "Message Id",
              "type": "string"
            },
            "part_id": {
              "pattern": "^prt[a-zA-Z0-9_-]+$",
              "title": "Part Id",
              "type": "string"
            },
            "excerpt": {
              "maxLength": 2000,
              "minLength": 1,
              "title": "Excerpt",
              "type": "string"
            }
          },
          "required": [
            "native_session_id",
            "message_id",
            "part_id",
            "excerpt"
          ],
          "title": "NativeCitation",
          "type": "object"
        },
        "TaskReviewInput": {
          "additionalProperties": false,
          "properties": {
            "execution_id": {
              "title": "Execution Id",
              "type": "string"
            },
            "expected_task_revision": {
              "minimum": 1,
              "title": "Expected Task Revision",
              "type": "integer"
            },
            "outcome": {
              "enum": [
                "COMPLETED",
                "REWORK",
                "WAIT_HUMAN"
              ],
              "title": "Outcome",
              "type": "string"
            },
            "criteria_results": {
              "items": {
                "$ref": "#/$defs/CriterionResult"
              },
              "maxItems": 100,
              "minItems": 1,
              "title": "Criteria Results",
              "type": "array"
            }
          },
          "required": [
            "execution_id",
            "expected_task_revision",
            "outcome",
            "criteria_results"
          ],
          "title": "TaskReviewInput",
          "type": "object"
        }
      },
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/TaskReviewInput"
        },
        "operation_key": {
          "title": "Operation Key",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "payload",
        "operation_key"
      ],
      "title": "task_reviewArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "task_reviewDictOutput",
      "type": "object"
    }
  },
  {
    "name": "astra_task_evidence",
    "description": "经当前工程 Grant 读取原生工具证据供独立验收，不从 Worker 自述推断成功。",
    "inputSchema": {
      "properties": {
        "execution_id": {
          "title": "Execution Id",
          "type": "string"
        }
      },
      "required": [
        "execution_id"
      ],
      "title": "task_evidenceArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "task_evidenceDictOutput",
      "type": "object"
    }
  },
  {
    "name": "astra_channel_send",
    "description": "在当前 Channel 成员资格内发送消息，自动消息须引用因果来源。",
    "inputSchema": {
      "$defs": {
        "MessageInput": {
          "additionalProperties": false,
          "properties": {
            "content": {
              "maxLength": 20000,
              "minLength": 1,
              "title": "Content",
              "type": "string"
            },
            "mentions": {
              "items": {
                "type": "string"
              },
              "title": "Mentions",
              "type": "array"
            },
            "attachment_refs": {
              "items": {
                "type": "string"
              },
              "title": "Attachment Refs",
              "type": "array"
            },
            "reply_to": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Reply To"
            },
            "causal_root": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Causal Root"
            },
            "source_event_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Source Event Id"
            }
          },
          "required": [
            "content"
          ],
          "title": "MessageInput",
          "type": "object"
        }
      },
      "properties": {
        "channel_id": {
          "title": "Channel Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/MessageInput"
        },
        "operation_key": {
          "title": "Operation Key",
          "type": "string"
        }
      },
      "required": [
        "channel_id",
        "payload",
        "operation_key"
      ],
      "title": "channel_sendArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "channel_sendDictOutput",
      "type": "object"
    }
  },
  {
    "name": "astra_operation_prepare",
    "description": "准备具体审批；模型不能代替人类批准或改变授权规则。",
    "inputSchema": {
      "$defs": {
        "OperationInput": {
          "additionalProperties": false,
          "properties": {
            "team_id": {
              "title": "Team Id",
              "type": "string"
            },
            "action": {
              "enum": [
                "task.pause",
                "task.cancel",
                "employee.pause",
                "knowledge.publish"
              ],
              "title": "Action",
              "type": "string"
            },
            "target_id": {
              "title": "Target Id",
              "type": "string"
            },
            "payload": {
              "additionalProperties": true,
              "title": "Payload",
              "type": "object"
            },
            "expires_in": {
              "default": 3600,
              "maximum": 86400,
              "minimum": 60,
              "title": "Expires In",
              "type": "integer"
            }
          },
          "required": [
            "team_id",
            "action",
            "target_id"
          ],
          "title": "OperationInput",
          "type": "object"
        }
      },
      "properties": {
        "payload": {
          "$ref": "#/$defs/OperationInput"
        },
        "operation_key": {
          "title": "Operation Key",
          "type": "string"
        }
      },
      "required": [
        "payload",
        "operation_key"
      ],
      "title": "operation_prepareArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "operation_prepareDictOutput",
      "type": "object"
    }
  },
  {
    "name": "astra_memory_read",
    "description": "读取本人或经后端授权的个人 Git Memory；内容不授予业务权限。",
    "inputSchema": {
      "properties": {
        "employee_id": {
          "title": "Employee Id",
          "type": "string"
        }
      },
      "required": [
        "employee_id"
      ],
      "title": "memory_readArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "memory_readDictOutput",
      "type": "object"
    }
  },
  {
    "name": "astra_memory_write",
    "description": "基于当前 head 提交有来源的记忆新版本，越权或并发旧版本由后端拒绝。",
    "inputSchema": {
      "$defs": {
        "MemoryWriteInput": {
          "additionalProperties": false,
          "properties": {
            "expected_head": {
              "anyOf": [
                {
                  "pattern": "^[a-f0-9]{40}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Expected Head"
            },
            "content": {
              "maxLength": 16000,
              "title": "Content",
              "type": "string"
            },
            "notes": {
              "description": "文件名不含 notes/ 前缀",
              "maxProperties": 20,
              "patternProperties": {
                "^[a-z0-9][a-z0-9_-]{0,63}\\.md$": {
                  "type": "string"
                }
              },
              "title": "Notes",
              "type": "object"
            },
            "source_refs": {
              "items": {
                "type": "string"
              },
              "maxItems": 30,
              "minItems": 1,
              "title": "Source Refs",
              "type": "array"
            },
            "reason": {
              "maxLength": 1000,
              "minLength": 1,
              "title": "Reason",
              "type": "string"
            },
            "expires_at": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Expires At"
            }
          },
          "required": [
            "expected_head",
            "content",
            "source_refs",
            "reason"
          ],
          "title": "MemoryWriteInput",
          "type": "object"
        }
      },
      "properties": {
        "employee_id": {
          "title": "Employee Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/MemoryWriteInput"
        },
        "operation_key": {
          "title": "Operation Key",
          "type": "string"
        }
      },
      "required": [
        "employee_id",
        "payload",
        "operation_key"
      ],
      "title": "memory_writeArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "memory_writeDictOutput",
      "type": "object"
    }
  },
  {
    "name": "astra_event_read",
    "description": "读取当前授权的 SourceEvent 引用；不会据此自动标记已处理。",
    "inputSchema": {
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        }
      },
      "required": [
        "event_id"
      ],
      "title": "event_readArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "event_readDictOutput",
      "type": "object"
    }
  },
  {
    "name": "astra_inbox_list",
    "description": "读取认证员工本人的 Inbox，不接受模型自报员工身份。",
    "inputSchema": {
      "properties": {},
      "title": "inbox_listArguments",
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Result",
          "type": "array"
        }
      },
      "required": [
        "result"
      ],
      "title": "inbox_listOutput",
      "type": "object"
    }
  }
]
