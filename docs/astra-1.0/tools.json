    "inputSchema": {
      "properties": {},
      "title": "context_getArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "context_getDictOutput",
      "type": "object"
    }
  },
  {
    "name": "astra_goal_list",
    "description": "查询当前授权范围内的长期目标。",
    "inputSchema": {
      "properties": {},
      "title": "goal_listArguments",
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Result",
          "type": "array"
        }
      },
      "required": [
        "result"
      ],
