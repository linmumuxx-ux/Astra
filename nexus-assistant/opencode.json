{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "deny",
    "write": "deny",
    "bash": "deny",
    "webfetch": "deny",
    "skill": {
      "*": "deny",
      "nexus-*": "allow"
    }
  },
  "mcp": {
    "nexus-assistant": {
      "type": "local",
      "command": ["astra-assistant-mcp"],
      "enabled": true
    }
  }
}
