# 复制为 nexus/deploy/.env 后再填写。不要把密钥提交进仓库。
# Nexus 页面没有模型或凭证字段。模型只存在于 Agent Service 的 credential。

AGENTSCOPE_REDIS_HOST=127.0.0.1
AGENTSCOPE_REDIS_PORT=6379
AGENTSCOPE_REDIS_PASSWORD=
AGENTSCOPE_WORKSPACE_DIR=nexus/deploy/data/workspaces
AGENTSCOPE_HOST=0.0.0.0
AGENTSCOPE_PORT=8000

NEXUS_API_BASE=http://127.0.0.1:8120
NEXUS_DATA_DIR=nexus/api/data
NEXUS_AGENTSCOPE_BASE_URL=http://127.0.0.1:8000
NEXUS_AGENTSCOPE_USER_ID=nexus

# bootstrap_chat_model.py 打印这一行。留空时 Session 没有模型，聊天不会产生文本增量。
# NEXUS_AGENTSCOPE_CHAT_MODEL_CONFIG={"type":"ollama_credential","credential_id":"...","model":"qwen2.5:3b","parameters":{}}

# 默认用本机 Ollama。改成 openai 时改为 NEXUS_CHAT_PROVIDER=openai，并设置 OPENAI_API_KEY 与 OPENAI_MODEL。
NEXUS_CHAT_PROVIDER=ollama
NEXUS_OLLAMA_HOST=http://127.0.0.1:11434
NEXUS_OLLAMA_MODEL=qwen2.5:3b
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
