# Nexus 唯一环境模板。复制为 ops/env/.env（chmod 600）后填写。
# 本地脚本读取 ops/env/.env；没有该文件时回退到仓库根目录 .env。
# install_nexus.sh 读取顺序：当前进程环境 > --env-file > ops/deploy/.env > ops/env/.env
# 只放占位符。不要把密钥、credential id 或 SSH 密码写进仓库。

# ---- 安装（ops/deploy/install_nexus.sh）----
NEXUS_REPO_URL=https://github.com/linmumuxx-ux/Astra
NEXUS_BRANCH=cursor/nexus-v1-0-1-phase2-f6f2
NEXUS_ROOT=/opt/nexus
NEXUS_STATE_DIR=/var/lib/nexus
NEXUS_BIND_HOST=127.0.0.1

# ---- 模型 ----
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash

# Agent Service 聊天模型引用。由 bootstrap_chat_model.py 打印，不要手写 credential id。
# NEXUS_AGENTSCOPE_CHAT_MODEL_CONFIG=

# ---- 任务平台（services/task-platform，端口 8100 / 8110 / 8201 / 8202）----
ASTRA_ENVIRONMENT=development
ASTRA_DATABASE_BACKEND=sqlite
# 生产示例：mysql，并填写下面的主机、库名和密码占位。
# ASTRA_DATABASE_BACKEND=mysql
ASTRA_DATABASE_HOST=127.0.0.1
ASTRA_DATABASE_PORT=3306
ASTRA_DATABASE_NAME=astra
ASTRA_DATABASE_USERNAME=astra
ASTRA_DATABASE_PASSWORD=
ASTRA_DATABASE_CHARSET=utf8mb4
ASTRA_DATABASE_POOL_RECYCLE=1800
ASTRA_DATA_DIR=services/task-platform/data
ASTRA_WORKSPACE_ROOT=services/task-platform/workspaces
ASTRA_LOG_DIR=.astra/logs
ASTRA_RUNTIME_DIR=.astra/run
ASTRA_CONFIG_DIR=services/task-platform/configs
ASTRA_SEED_DEMO=true
ASTRA_REDIS_URL=redis://127.0.0.1:6379/0

ASTRA_EXECUTOR_TYPE=opencode_server
ASTRA_OPENCODE_BINARY=opencode
ASTRA_OPENCODE_AGENT=
# Worker / OpenCode 默认。对话仍用 OPENAI_MODEL=deepseek-flash。
ASTRA_OPENCODE_MODEL=deepseek/deepseek-flash
ASTRA_OPENCODE_TIMEOUT_SECONDS=3600
ASTRA_OPENCODE_SERVER_HOSTNAME=127.0.0.1
ASTRA_OPENCODE_SERVER_PORT=4096
ASTRA_OPENCODE_SERVER_USERNAME=opencode
ASTRA_OPENCODE_SERVER_MIN_VERSION=1.18.25
ASTRA_OPENCODE_SERVER_VERSION_CHECK_ENABLED=true
# ASTRA_OPENCODE_SERVER_PASSWORD=

ASTRA_NEXUS_API_BASE=http://127.0.0.1:8120
ASTRA_AGENTSCOPE_BASE_URL=http://127.0.0.1:8000
ASTRA_AGENTSCOPE_USER_ID=nexus
ASTRA_TASK_MCP_HOST=127.0.0.1
ASTRA_TASK_MCP_PORT=8202
# 与 NEXUS_TASK_MCP_KEY 必须相同。留空时 Task MCP 拒绝所有调用。
# ASTRA_TASK_MCP_KEY=
ASTRA_OUTBOX_INTERVAL=2
ASTRA_OUTBOX_RETRY_SECONDS=5
ASTRA_INACTIVITY_TIMEOUT=900
ASTRA_RECOVERY_INTERVAL=30
ASTRA_RUNTIME_STARTUP_TIMEOUT=120
ASTRA_RUNTIME_HEARTBEAT_TIMEOUT=90

ASTRA_MCP_TRANSPORT=stdio
ASTRA_MCP_HOST=127.0.0.1
ASTRA_MCP_PORT=8201
ASTRA_MCP_STREAMABLE_HTTP_PATH=/mcp
# ASTRA_MCP_API_KEY=
# ASTRA_MCP_ISSUER_URL=https://nexus.example.internal
# ASTRA_MCP_RESOURCE_SERVER_URL=https://nexus.example.internal/mcp

ASTRA_ASSISTANT_ENABLED=true
ASTRA_ASSISTANT_OPENCODE_HOSTNAME=127.0.0.1
ASTRA_ASSISTANT_OPENCODE_PORT=4097
ASTRA_ASSISTANT_OPENCODE_USERNAME=opencode
# ASTRA_ASSISTANT_OPENCODE_PASSWORD=
ASTRA_ASSISTANT_AGENT=platform-assistant
ASTRA_ASSISTANT_USER_ID=console-admin
ASTRA_ASSISTANT_REQUEST_TIMEOUT_SECONDS=120
ASTRA_ASSISTANT_RATE_LIMIT_PER_MINUTE=30
ASTRA_ASSISTANT_OPERATION_TTL_MINUTES=15

ASTRA_GATEWAY_ENABLED=true
ASTRA_GATEWAY_PROBE_TIMEOUT_SECONDS=30
# ASTRA_GATEWAY_MASTER_KEY=
ASTRA_SERVICE_GATEWAY_HOST=127.0.0.1
ASTRA_SERVICE_GATEWAY_PORT=8110
ASTRA_SERVICE_BACKEND_HOST=0.0.0.0
ASTRA_SERVICE_BACKEND_PORT=8100
ASTRA_SERVICE_FRONTEND_HOST=0.0.0.0
ASTRA_SERVICE_FRONTEND_PORT=5174

ASTRA_NR_TEST_SYSTEM_ENDPOINT=http://localhost:8000
ASTRA_NR_TEST_SYSTEM_DISCOVER_PATH=/api/astra/tasks
ASTRA_NR_TEST_SYSTEM_RESULT_PATH=/api/astra/tasks/{external_task_id}/result
ASTRA_NR_TEST_SYSTEM_TOKEN=

ASTRA_REMOTE_OPENCODE_VERSION=1.18.33
ASTRA_REMOTE_NODE_VERSION=22.23.3
ASTRA_REMOTE_NPM_REGISTRY=https://registry.npmmirror.com
ASTRA_REMOTE_DEPLOY_TIMEOUT_SECONDS=1200
ASTRA_REMOTE_GATEWAY_LOCAL_URL=http://127.0.0.1:8110
# ASTRA_REMOTE_GATEWAY_PUBLIC_URL=https://gateway.example.com

# ---- Nexus API（services/nexus-api，端口 8120）----
NEXUS_DATA_DIR=services/nexus-api/data
NEXUS_AGENTSCOPE_BASE_URL=http://127.0.0.1:8000
NEXUS_AGENTSCOPE_USER_ID=nexus
NEXUS_TASK_MCP_URL=http://127.0.0.1:8202/mcp
# 与 ASTRA_TASK_MCP_KEY 必须相同。Nexus 把它放进 Session 绑定的 MCP 请求头。
# NEXUS_TASK_MCP_KEY=
NEXUS_CHAT_PROVIDER=openai
# 本机没有付费密钥时可改为 ollama，并设置 NEXUS_OLLAMA_HOST / NEXUS_OLLAMA_MODEL。
# NEXUS_CHAT_PROVIDER=ollama
# NEXUS_OLLAMA_HOST=http://127.0.0.1:11434
# NEXUS_OLLAMA_MODEL=qwen2.5:3b

# ---- Agent Service（services/agent-service，端口 8000）----
NEXUS_API_BASE=http://127.0.0.1:8120
AGENTSCOPE_HOST=0.0.0.0
AGENTSCOPE_PORT=8000
AGENTSCOPE_REDIS_HOST=127.0.0.1
AGENTSCOPE_REDIS_PORT=6379
AGENTSCOPE_REDIS_PASSWORD=
AGENTSCOPE_WORKSPACE_DIR=services/agent-service/data/workspaces

# ---- llm_wiki（tools/llm_wiki，--with-llm-wiki）----
ASTRA_LLM_WIKI_ENABLED=false
ASTRA_LLM_WIKI_API_BASE_URL=http://127.0.0.1:19828/api/v1
ASTRA_LLM_WIKI_API_TOKEN=
ASTRA_LLM_WIKI_PROJECT_ID=
ASTRA_LLM_WIKI_TIMEOUT=30
LLM_WIKI_HOST=
LLM_WIKI_SSH_USER=root
# LLM_WIKI_SSH_KEY=$HOME/.ssh/llmwiki_tunnel
LLM_WIKI_SSH_PASSWORD=
LLM_WIKI_BUNDLE=
LLM_WIKI_REMOTE_PORT=18080
LLM_WIKI_LOCAL_PORT=19828
LLM_WIKI_API_TOKEN=
LLM_WIKI_PROJECT_ID=

# ---- 远程 Worker（--remote-worker）----
REMOTE_WORKER_ID=p2-remote
REMOTE_WORKER_USER=root
REMOTE_WORKER_PORT=22
REMOTE_WORKER_SSH_PASSWORD=
REMOTE_WORKER_OPENCODE_PORT=4296
REMOTE_WORKER_WORKSPACE=/root/astra-remote
