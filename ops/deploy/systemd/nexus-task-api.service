[Unit]
Description=Nexus Task API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexus
Group=nexus
WorkingDirectory=/opt/nexus/services/task-platform
EnvironmentFile=/var/lib/nexus/nexus.env
ExecStartPre=/opt/nexus/services/task-platform/.venv/bin/alembic upgrade head
ExecStart=/opt/nexus/services/task-platform/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8100
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
