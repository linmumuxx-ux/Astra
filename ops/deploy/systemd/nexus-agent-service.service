[Unit]
Description=Nexus AgentScope Agent Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexus
Group=nexus
WorkingDirectory=/opt/nexus/services/agent-service
EnvironmentFile=/var/lib/nexus/nexus.env
ExecStart=/opt/nexus/services/agent-service/.venv-agentscope/bin/python /opt/nexus/services/agent-service/agent_service.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
