[Unit]
Description=Nexus employee OpenCode Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexus
Group=nexus
WorkingDirectory=/opt/nexus/services/task-platform
EnvironmentFile=/var/lib/nexus/nexus.env
ExecStart=/opt/nexus/services/task-platform/.venv/bin/python -m app.runtime.opencode_server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
