[Unit]
Description=Nexus Task MCP
After=network-online.target nexus-task-api.service
Wants=network-online.target

[Service]
Type=simple
User=nexus
Group=nexus
WorkingDirectory=/opt/nexus/services/task-platform
EnvironmentFile=/var/lib/nexus/nexus.env
Environment=ASTRA_TASK_MCP_PORT=8202
ExecStart=/opt/nexus/services/task-platform/.venv/bin/astra-task-mcp
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
