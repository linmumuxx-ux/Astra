[Unit]
Description=Nexus API
After=network-online.target nexus-agent-service.service
Wants=network-online.target

[Service]
Type=simple
User=nexus
Group=nexus
WorkingDirectory=/opt/nexus/services/nexus-api
EnvironmentFile=/var/lib/nexus/nexus.env
ExecStart=/opt/nexus/services/nexus-api/.venv/bin/uvicorn nexus_api.main:app --app-dir /opt/nexus/services/nexus-api --host 127.0.0.1 --port 8120
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
