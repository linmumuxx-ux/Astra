[Unit]
Description=Astra NEXUS digital library MCP server
After=network-online.target mysql.service astra-backend.service
Wants=network-online.target
Requires=astra-backend.service

[Service]
Type=simple
User=astra
Group=astra
WorkingDirectory=/opt/astra/backend
EnvironmentFile=/etc/astra/astra.env
ExecStart=/opt/astra/.venv/bin/python -m app.mcp_server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
