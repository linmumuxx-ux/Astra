[Unit]
Description=Astra platform assistant OpenCode Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=astra
Group=astra
WorkingDirectory=/opt/astra/backend
EnvironmentFile=/etc/astra/astra.env
ExecStart=/opt/astra/.venv/bin/python -m app.assistant.server
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
