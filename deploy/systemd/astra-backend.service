[Unit]
Description=Astra FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=astra
Group=astra
WorkingDirectory=/opt/astra/backend
EnvironmentFile=/etc/astra/astra.env
ExecStartPre=/opt/astra/.venv/bin/alembic upgrade head
ExecStart=/opt/astra/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8100
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
