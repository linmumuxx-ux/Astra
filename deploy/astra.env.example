# Astra production environment. Windows may copy this file to .env and use native paths.
ASTRA_ENVIRONMENT=production
ASTRA_DATABASE_BACKEND=mysql
ASTRA_DATABASE_HOST=127.0.0.1
ASTRA_DATABASE_PORT=3306
ASTRA_DATABASE_NAME=astra
ASTRA_DATABASE_USERNAME=astra
ASTRA_DATABASE_PASSWORD=replace-with-a-strong-password
ASTRA_DATABASE_CHARSET=utf8mb4
ASTRA_DATABASE_POOL_RECYCLE=1800
ASTRA_REDIS_URL=redis://127.0.0.1:6379/0
# Windows examples: D:\Astra\data, D:\Astra\workspaces, D:\Astra\logs
ASTRA_DATA_DIR=/var/lib/astra/data
ASTRA_WORKSPACE_ROOT=/var/lib/astra/workspaces
ASTRA_LOG_DIR=/var/log/astra
ASTRA_RUNTIME_DIR=/var/lib/astra/run
ASTRA_CONFIG_DIR=/opt/astra/configs
ASTRA_SEED_DEMO=false
ASTRA_EXECUTOR_TYPE=opencode_server
ASTRA_OPENCODE_SERVER_HOSTNAME=127.0.0.1
ASTRA_OPENCODE_SERVER_PORT=4096
ASTRA_OPENCODE_SERVER_USERNAME=opencode
ASTRA_OPENCODE_SERVER_MIN_VERSION=1.18.25
# 公司环境自定义 OpenCode 构建需显式关闭版本校验时：false（不要用 MIN_VERSION=0.0.0）
ASTRA_OPENCODE_SERVER_VERSION_CHECK_ENABLED=true
# ASTRA_OPENCODE_SERVER_PASSWORD=
ASTRA_OPENCODE_BINARY=/usr/local/bin/opencode
ASTRA_OPENCODE_AGENT=
ASTRA_OPENCODE_MODEL=
ASTRA_OPENCODE_TIMEOUT_SECONDS=3600
# Platform assistant: project-level agent with an isolated OpenCode Server; owns no workspace.
ASTRA_ASSISTANT_ENABLED=true
ASTRA_ASSISTANT_OPENCODE_HOSTNAME=127.0.0.1
ASTRA_ASSISTANT_OPENCODE_PORT=4097
ASTRA_ASSISTANT_OPENCODE_USERNAME=opencode
# ASTRA_ASSISTANT_OPENCODE_PASSWORD=
ASTRA_ASSISTANT_AGENT=platform-assistant
ASTRA_ASSISTANT_MODEL=
ASTRA_ASSISTANT_USER_ID=console-admin
ASTRA_ASSISTANT_REQUEST_TIMEOUT_SECONDS=120
ASTRA_ASSISTANT_RATE_LIMIT_PER_MINUTE=30
ASTRA_ASSISTANT_OPERATION_TTL_MINUTES=15
# API 中转：控制面在主 Backend，数据面是独立 astra-gateway 进程（loopback，nginx 反代 /v1）。
ASTRA_GATEWAY_ENABLED=true
# Supply through a secret manager or the protected environment file. Never commit a real value.
# Fernet 主密钥（加密节点下游凭据）：
# ASTRA_GATEWAY_MASTER_KEY=replace-with-a-fernet-key
# 管理凭据：单个 token 或 JSON 数组 [{"name","token","roles":["view","node","route","key","publish","system"]}]
# ASTRA_GATEWAY_CONTROL_CREDENTIALS=[{"name":"admin","token":"replace-with-a-strong-random-token","roles":["system"]}]
# 数据面从 DB 追平已吊销 Key 阻断列表的周期（秒），Redis 清空/重启后据此重建。
# ASTRA_GATEWAY_REVOCATION_SYNC_INTERVAL=60
ASTRA_SERVICE_GATEWAY_HOST=127.0.0.1
ASTRA_SERVICE_GATEWAY_PORT=8110
# Digital Library MCP: keep loopback behind the company gateway/reverse proxy.
ASTRA_MCP_TRANSPORT=streamable-http
ASTRA_MCP_HOST=127.0.0.1
ASTRA_MCP_PORT=8201
ASTRA_MCP_STREAMABLE_HTTP_PATH=/mcp
ASTRA_MCP_ISSUER_URL=https://nexus.example.internal
ASTRA_MCP_RESOURCE_SERVER_URL=https://nexus.example.internal/mcp
# Supply through a secret manager or the protected environment file.
ASTRA_MCP_API_KEY=replace-with-a-strong-random-token
ASTRA_INACTIVITY_TIMEOUT=900
ASTRA_RECOVERY_INTERVAL=30
ASTRA_OUTBOX_INTERVAL=2
ASTRA_OUTBOX_RETRY_SECONDS=5
ASTRA_RUNTIME_STARTUP_TIMEOUT=120
ASTRA_RUNTIME_HEARTBEAT_TIMEOUT=90
ASTRA_NR_TEST_SYSTEM_ENDPOINT=https://nr-test.example.internal
ASTRA_NR_TEST_SYSTEM_DISCOVER_PATH=/api/astra/tasks
ASTRA_NR_TEST_SYSTEM_RESULT_PATH=/api/astra/tasks/{external_task_id}/result
# Supply through a secret manager or the protected environment file. Never commit a real value.
ASTRA_NR_TEST_SYSTEM_TOKEN=
