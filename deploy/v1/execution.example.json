{
  "projects": {
    "REPLACE_WITH_WORKER_UUID": {
      "REPLACE_WITH_PROJECT_ID": {
        "transport": "local",
        "repository": "/srv/astra/projects/example",
        "workspace_root": "/srv/astra/workspaces",
        "base_ref": "REPLACE_WITH_VERIFIED_COMMIT",
        "model": "provider/model",
        "permission_rules": [
          { "permission": "*", "pattern": "*", "action": "deny" },
          { "permission": "read", "pattern": "*", "action": "allow" },
          { "permission": "edit", "pattern": "*", "action": "allow" },
          { "permission": "bash", "pattern": "python3 -m unittest -v", "action": "allow" }
        ]
      }
    }
  }
}
