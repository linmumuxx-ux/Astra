# 必须使用独立 1.0 schema，不能指向旧库。
ASTRA_V1_DATABASE_URL=mysql+asyncmy://astra_v1:CHANGE_ME@127.0.0.1:3306/astra_v1
# Persona 与 Task Runtime 必须独立配置，秘密由安全部署渠道注入。
ASTRA_V1_PERSONA_URL=http://127.0.0.1:4097
ASTRA_V1_PERSONA_DIRECTORY=/var/lib/astra-v1/persona
ASTRA_V1_PERSONA_MODEL=provider/model
ASTRA_V1_PERSONA_CREDENTIAL_FILE=/run/secrets/astra-v1-persona.token
ASTRA_V1_MEMORY_ROOT=/var/lib/astra-v1/memory
ASTRA_V1_EXECUTION_CONFIG=/etc/astra-v1/execution.json
ASTRA_V1_EXECUTOR_CREDENTIAL_FILE=/run/secrets/astra-v1-executor.json
# 新队列与签发的 SYSTEM 身份，不能复用旧 Celery 队列或默认用户。
ASTRA_V1_BROKER_URL=redis://127.0.0.1:6379/2
ASTRA_V1_SCHEDULER_CREDENTIAL_FILE=/run/secrets/astra-v1-scheduler.token
ASTRA_V1_API_URL=http://127.0.0.1:8200
ASTRA_V1_MCP_RESOURCE_URL=http://127.0.0.1:8203/mcp
ASTRA_V1_MCP_PORT=8203
ASTRA_V1_HISTORY_ARTIFACT_ROOT=/var/lib/astra-v1/history
