# 复制为仓库根目录 .env 后再部署。不要提交真实秘密。
ASTRA_POSTGRES_PASSWORD=replace-with-a-strong-password
ASTRA_SEED_DEMO=false
ASTRA_FRONTEND_PORT=8080
ASTRA_BACKEND_PORT=8100

ASTRA_NR_TEST_SYSTEM_ENDPOINT=https://nr-test.example.internal
ASTRA_NR_TEST_SYSTEM_TOKEN=replace-with-secret

# Worker 容器内的 Linux OpenCode CLI 路径。
ASTRA_OPENCODE_BINARY=/usr/local/bin/opencode
