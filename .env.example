# Local development defaults use SQLite. Docker Compose overrides this with PostgreSQL.
ASTRA_DATABASE_URL=sqlite+aiosqlite:///./data/astra.db
ASTRA_REDIS_URL=redis://localhost:6379/0
ASTRA_WORKSPACE_ROOT=./workspaces
ASTRA_CONFIG_DIR=../configs
ASTRA_SEED_DEMO=true
ASTRA_EXECUTOR_TYPE=opencode_cli
ASTRA_OPENCODE_BINARY=opencode
ASTRA_OPENCODE_AGENT=maintainer
ASTRA_OPENCODE_TIMEOUT_SECONDS=3600
ASTRA_NR_TEST_SYSTEM_ENDPOINT=http://localhost:8000
ASTRA_NR_TEST_SYSTEM_DISCOVER_PATH=/api/astra/tasks
ASTRA_NR_TEST_SYSTEM_RESULT_PATH=/api/astra/tasks/{external_task_id}/result
# Supply through the environment only. Never commit a real value.
ASTRA_NR_TEST_SYSTEM_TOKEN=
