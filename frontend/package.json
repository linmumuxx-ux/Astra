{
  "name": "astra-console",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:workspace && vue-tsc -b && vite build",
    "type-check": "vue-tsc -b && node ../scripts/workspace_ui.mjs type-check",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "build:workspace": "node ../scripts/workspace_ui.mjs build"
  },
  "dependencies": {
    "@vueuse/core": "^13.9.0",
    "dompurify": "^3.4.14",
    "echarts": "^6.0.0",
    "lucide-vue-next": "^0.544.0",
    "marked": "^18.0.11",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.7.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vue-tsc": "^3.1.1"
  }
}
